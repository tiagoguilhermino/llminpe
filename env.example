SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional: only needed by eval_rag.py when using the service-role bypass
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

NVIDIA_API_KEY=your_nvidia_api_key
OPENAI_EMBEDDING_MODEL_KEY=your_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_TIMEOUT=120
NVIDIA_MAX_COMPLETION_TOKENS=2048
NVIDIA_RETRY_ATTEMPTS=2
NVIDIA_RETRY_DELAY=5
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key

ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
ENV=dev
TESTE_EVAL=false

# RAG evaluation (eval_rag.py)
EVAL_DATASET=Dataset_eval_RAG_INPE.csv
EVAL_LIMIT=0
EVAL_JWT_TOKEN=your_eval_jwt_token
EVAL_API_URL=http://127.0.0.1:8000
EVAL_TIMEOUT=300
EVAL_SLEEP=5
